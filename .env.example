# Local development: copy to .env in the repo root. The api, worker and db scripts all read it.
# The web app needs nothing locally: Vite proxies /api to localhost:4000.

NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# Postgres (Render: use the External Database URL for both when running locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weddingmemories
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/weddingmemories

# Cloudinary (dashboard → Settings → API Keys → "API environment variable")
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Keeps dev uploads apart from production in the same Cloudinary account
CLOUDINARY_FOLDER=wm-dev

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_GUEST=
JWT_SECRET_ADMIN=
OTP_SECRET=

# Without a key, OTP emails are printed to the API log instead of being sent
RESEND_API_KEY=
MAIL_FROM="Wedding Memories <photos@example.com>"

WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
WORKER_CONCURRENCY=4

# pnpm db:seed
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=
SEED_EVENT_SLUG=demo-wedding
SEED_EVENT_NAME="Aisha & Omar"
SEED_EVENT_DATE=2026-12-12T16:00:00Z
