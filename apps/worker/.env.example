# Environment for the worker (Render: Background Worker).
# Locally, all apps read the root .env instead; copy ../../.env.example.
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=
DIRECT_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Photos processed in parallel. 1 on a 512 MB instance, 2-3 with 1-2 GB.
WORKER_CONCURRENCY=2

# "Your download is ready" emails (printed to the log if RESEND_API_KEY is empty)
RESEND_API_KEY=
MAIL_FROM=Wedding Memories <photos@your-domain.com>
# Used for the admin-panel link in emails
PUBLIC_WEB_URL=
