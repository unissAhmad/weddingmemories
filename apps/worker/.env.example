# Environment for the worker (Render: Background Worker, or run with the API via start-all).
# Locally, all apps read the root .env instead; copy ../../.env.example.
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=
DIRECT_URL=

# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Photos processed in parallel. Each job is two small requests to Cloudinary.
WORKER_CONCURRENCY=4
