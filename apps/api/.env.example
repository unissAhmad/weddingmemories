# Environment for the API service (Render: Web Service).
# Locally, all apps read the root .env instead; copy ../../.env.example.
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

DATABASE_URL=
DIRECT_URL=

# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=wedding-memories

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_GUEST=
# Also encrypts admins' TOTP secrets; changing it forces everyone to re-enrol 2FA.
JWT_SECRET_ADMIN=
OTP_SECRET=

RESEND_API_KEY=
MAIL_FROM=Wedding Memories <photos@your-domain.com>

# Comma-separated if there are several (e.g. https://photos.example.com)
WEB_ORIGIN=
# Guest-facing URL for QR codes and emails (defaults to the first WEB_ORIGIN)
PUBLIC_WEB_URL=
# Leave empty unless the cookie must be shared across subdomains
COOKIE_DOMAIN=
TRUST_PROXY=1
# Cloudinary free plan: 10 MB per image
MAX_UPLOAD_MB=10
# Public URL of this API for ZIP download links (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_API_URL=
